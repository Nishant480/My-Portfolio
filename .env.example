# --- Auth (admin panel) ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The ONLY Google account allowed into /admin
ADMIN_EMAIL=you@gmail.com

# --- Content storage (optional locally, required on Vercel) ---
# Without these, content is saved to data/content.json on disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=portfolio
